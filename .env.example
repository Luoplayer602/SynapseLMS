SYNAPSE_ENV=development
SYNAPSE_DEBUG=true
# Optional in development: blank uses an ephemeral key and restarting signs users out.
# Required in production: generate a random secret with at least 48 characters.
SYNAPSE_JWT_SECRET=
SYNAPSE_COOKIE_SECURE=false
SYNAPSE_ACCESS_MINUTES=15
SYNAPSE_SESSION_DAYS=7
SYNAPSE_FRONTEND_URL=http://localhost:5173
# Direct local API: set smtp and start Docker mailpit. Compose uses internal mailpit.
SYNAPSE_MAIL_BACKEND=disabled
SYNAPSE_MAIL_FROM=noreply@example.com
SYNAPSE_SMTP_HOST=localhost
SYNAPSE_SMTP_PORT=1025
SYNAPSE_SMTP_SECURITY=none
SYNAPSE_SMTP_USERNAME=
SYNAPSE_SMTP_PASSWORD=
SYNAPSE_SMTP_TIMEOUT=10
SYNAPSE_VERIFICATION_MINUTES=1440
SYNAPSE_RESET_MINUTES=30
SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:synapse@db:5432/synapse
SYNAPSE_CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me
