SYNAPSE_ENV=development
SYNAPSE_DEBUG=true
# Optional in development: blank uses an ephemeral key and restarting signs users out.
# Required in production: generate a random secret with at least 48 characters.
SYNAPSE_JWT_SECRET=
SYNAPSE_COOKIE_SECURE=false
SYNAPSE_ACCESS_MINUTES=15
SYNAPSE_SESSION_DAYS=7
SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:synapse@db:5432/synapse
SYNAPSE_CORS_ORIGINS=["http://localhost:5173"]
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me
