{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://synapselms-7e172b4c.fastapicloud.dev/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
